# Sao chep file nay thanh .env va dien gia tri that. KHONG commit .env (da co trong .gitignore).
# Ten model dung THAT van phai khai bao lai trong code/metadata.json (README muc 9.4) - .env chi de giu key.

LLM_PROVIDER=groq
LLM_MODEL=llama-3.1-8b-instant
LLM_BASE_URL=https://api.groq.com/openai/v1
LLM_API_KEY=your_groq_api_key_here

# Neu dung Ollama local thay vi Groq (fallback khi mat mang / het quota), doi thanh:
# LLM_PROVIDER=ollama
# LLM_MODEL=qwen2.5:7b-instruct
# LLM_BASE_URL=http://localhost:11434/v1
# LLM_API_KEY=ollama
